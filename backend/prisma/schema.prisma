generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  trader
  admin
  super_admin
}

enum ChallengeStatus {
  draft
  pending_payment
  payment_confirmed
  assigned
  active
  under_review
  passed
  failed
  payout_pending
  payout_requested
  payout_under_review
  payout_approved
  payout_paid
  payout_rejected
  suspended
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  manual_review
}

enum SubmissionStatus {
  pending
  received
  under_review
  approved
  rejected
}

enum ReviewStatus {
  pending
  approved
  rejected
  needs_more_info
}

enum PayoutStatus {
  draft
  requested
  eligibility_failed
  under_review
  approved
  paid
  rejected
  cancelled
}

enum MetricSource {
  manual
  admin
  api
  import
}

enum SubmissionType {
  screenshot
  statement
  account_report
  other
}

enum PaymentProvider {
  manual
  paypal
  stripe
  flutterwave
  paystack
  mpesa
  nowpayments
  other
}

enum AuditEventType {
  user_applied
  payment_checkout_created
  payment_received
  payment_failed
  payment_mismatch_detected
  challenge_assigned
  challenge_started
  metrics_recorded
  rule_breached
  challenge_passed
  challenge_failed
  submission_created
  submission_reviewed
  payout_requested
  payout_approved
  payout_rejected
  payout_paid
  admin_action
}

enum AuditEntityType {
  user
  funded_challenge
  challenge_account
  payment
  submission
  review_decision
  payout_request
  admin_note
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         UserRole @default(trader)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  challengeAccounts   ChallengeAccount[]
  submissions         Submission[]
  payoutRequests      PayoutRequest[]      @relation("PayoutRequester")
  payments            Payment[]
  passwordResetTokens PasswordResetToken[]
  reviewDecisions     ReviewDecision[]     @relation("ReviewerReviewDecisions")
  payoutReviews       PayoutRequest[]      @relation("PayoutReviewer")
  adminNotes          AdminNote[]
  auditLogs           AuditLog[]           @relation("AuditActorUser")
  affiliateProfile     Affiliate?

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model FundedChallenge {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String
  feeAmount             Decimal  @map("fee_amount") @db.Decimal(12, 2)
  currency              String   @db.VarChar(10)
  virtualBalance        Decimal  @map("virtual_balance") @db.Decimal(14, 2)
  rewardAmount          Decimal  @default(100.00) @map("reward_amount") @db.Decimal(12, 2)
  profitTargetPct       Decimal  @map("profit_target_pct") @db.Decimal(5, 2)
  maxDailyLossPct       Decimal  @map("max_daily_loss_pct") @db.Decimal(5, 2)
  maxOverallDrawdownPct Decimal  @map("max_overall_drawdown_pct") @db.Decimal(5, 2)
  maxDailyProfitPct     Decimal  @default(35.00) @map("max_daily_profit_pct") @db.Decimal(5, 2)
  maxRiskPerTradePct    Decimal  @default(2.00) @map("max_risk_per_trade_pct") @db.Decimal(5, 2)
  maxLotSize            Decimal  @default(1.00) @map("max_lot_size") @db.Decimal(8, 2)
  minTradingDays        Int      @map("min_trading_days")
  maxDurationDays       Int?     @map("max_duration_days")
  payoutRatioPct        Decimal  @map("payout_ratio_pct") @db.Decimal(5, 2)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  challengeAccounts ChallengeAccount[]

  @@index([isActive])
  @@index([createdAt])
  @@map("funded_challenges")
}

model Affiliate {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  slug      String   @unique @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([createdAt])
  @@map("affiliates")
}

model ChallengeAccount {
  id                      String          @id @default(cuid())
  userId                  String          @map("user_id")
  challengeId             String          @map("challenge_id")
  status                  ChallengeStatus @default(pending_payment)
  paymentStatus           PaymentStatus   @default(pending) @map("payment_status")
  assignedAt              DateTime?       @map("assigned_at")
  startedAt               DateTime?       @map("started_at")
  endedAt                 DateTime?       @map("ended_at")
  initialBalance          Decimal         @map("initial_balance") @db.Decimal(14, 2)
  dayStartBalance         Decimal         @map("day_start_balance") @db.Decimal(14, 2)
  dayStartEquity          Decimal?        @map("day_start_equity") @db.Decimal(14, 2)
  intradayMinEquity       Decimal?        @map("intraday_min_equity") @db.Decimal(14, 2)
  dailyLossBreached       Boolean         @default(false) @map("daily_loss_breached")
  overallDrawdownBreached Boolean         @default(false) @map("overall_drawdown_breached")
  consistencyBreached     Boolean         @default(false) @map("consistency_breached")
  riskBreached            Boolean         @default(false) @map("risk_breached")
  maxObservedLot          Decimal         @default(0) @map("max_observed_lot") @db.Decimal(8, 2)
  maxObservedRiskPct      Decimal         @default(0) @map("max_observed_risk_pct") @db.Decimal(5, 2)
  dayStartAt              DateTime?       @map("day_start_at")
  dayId                   String?         @map("day_id")
  currentBalance          Decimal         @default(0) @map("current_balance") @db.Decimal(14, 2)
  currentEquity           Decimal         @default(0) @map("current_equity") @db.Decimal(14, 2)
  peakEquity              Decimal         @default(0) @map("peak_equity") @db.Decimal(14, 2)
  totalPnl                Decimal         @default(0) @map("total_pnl") @db.Decimal(14, 2)
  dailyLossPct            Decimal         @default(0) @map("daily_loss_pct") @db.Decimal(6, 3)
  overallDrawdownPct      Decimal         @default(0) @map("overall_drawdown_pct") @db.Decimal(5, 2)
  tradingDaysCount        Int             @default(0) @map("trading_days_count")
  lastMetricsAt           DateTime?       @map("last_metrics_at")
  passedAt                DateTime?       @map("passed_at")
  failedAt                DateTime?       @map("failed_at")
  failureReason           String?         @map("failure_reason") @db.Text
  ref                     String?         @db.VarChar(100)
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  challenge       FundedChallenge         @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  ruleSnapshots   ChallengeRuleSnapshot[]
  metricSnapshots MetricSnapshot[]
  submissions     Submission[]
  reviewDecisions ReviewDecision[]
  payoutRequests  PayoutRequest[]
  payments        Payment[]
  adminNotes      AdminNote[]
  brokerAccounts  BrokerAccount[]

  @@index([userId])
  @@index([challengeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([ref])
  @@index([createdAt])
  @@index([userId, challengeId])
  @@index([userId, status])
  @@map("challenge_accounts")
}

model ChallengeRuleSnapshot {
  id                    String   @id @default(cuid())
  challengeAccountId    String   @map("challenge_account_id")
  profitTargetPct       Decimal  @map("profit_target_pct") @db.Decimal(5, 2)
  maxDailyLossPct       Decimal  @map("max_daily_loss_pct") @db.Decimal(5, 2)
  maxOverallDrawdownPct Decimal  @map("max_overall_drawdown_pct") @db.Decimal(5, 2)
  maxDailyProfitPct     Decimal  @default(35.00) @map("max_daily_profit_pct") @db.Decimal(5, 2)
  maxRiskPerTradePct    Decimal  @default(2.00) @map("max_risk_per_trade_pct") @db.Decimal(5, 2)
  maxLotSize            Decimal  @default(1.00) @map("max_lot_size") @db.Decimal(8, 2)
  minTradingDays        Int      @map("min_trading_days")
  maxDurationDays       Int?     @map("max_duration_days")
  payoutRatioPct        Decimal  @map("payout_ratio_pct") @db.Decimal(5, 2)
  rawRulesJson          Json     @map("raw_rules_json")
  createdAt             DateTime @default(now()) @map("created_at")

  challengeAccount ChallengeAccount @relation(fields: [challengeAccountId], references: [id], onDelete: Cascade)

  @@index([challengeAccountId])
  @@map("challenge_rule_snapshots")
}

model MetricSnapshot {
  id                 String       @id @default(cuid())
  challengeAccountId String       @map("challenge_account_id")
  source             MetricSource
  balance            Decimal      @db.Decimal(14, 2)
  equity             Decimal      @db.Decimal(14, 2)
  peakEquity         Decimal      @map("peak_equity") @db.Decimal(14, 2)
  dayStartEquity     Decimal?     @map("day_start_equity") @db.Decimal(14, 2)
  dayId              String?      @map("day_id")
  realizedPnl        Decimal      @map("realized_pnl") @db.Decimal(14, 2)
  unrealizedPnl      Decimal      @map("unrealized_pnl") @db.Decimal(14, 2)
  dailyLossPct       Decimal      @map("daily_loss_pct") @db.Decimal(6, 3)
  overallDrawdownPct Decimal      @map("overall_drawdown_pct") @db.Decimal(5, 2)
  tradingDaysCount   Int          @map("trading_days_count")
  snapshotTime       DateTime     @map("snapshot_time")
  maxObservedLot     Decimal?     @map("max_observed_lot") @db.Decimal(8, 2)
  maxObservedRiskPct Decimal?     @map("max_observed_risk_pct") @db.Decimal(5, 2)
  rawPayloadJson     Json?        @map("raw_payload_json")
  createdAt          DateTime     @default(now()) @map("created_at")

  challengeAccount ChallengeAccount @relation(fields: [challengeAccountId], references: [id], onDelete: Cascade)

  @@index([challengeAccountId])
  @@index([snapshotTime])
  @@index([dayId])
  @@index([challengeAccountId, snapshotTime])
  @@map("metric_snapshots")
}

model Submission {
  id                 String           @id @default(cuid())
  challengeAccountId String           @map("challenge_account_id")
  userId             String           @map("user_id")
  submissionType     SubmissionType   @map("submission_type")
  note               String?          @db.Text
  fileUrl            String?          @map("file_url")
  status             SubmissionStatus @default(received)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  challengeAccount ChallengeAccount @relation(fields: [challengeAccountId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewDecisions  ReviewDecision[]

  @@index([challengeAccountId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("submissions")
}

model ReviewDecision {
  id                 String       @id @default(cuid())
  submissionId       String?      @map("submission_id")
  challengeAccountId String       @map("challenge_account_id")
  reviewerId         String       @map("reviewer_id")
  status             ReviewStatus
  decisionNote       String?      @map("decision_note") @db.Text
  metadataJson       Json?        @map("metadata_json")
  createdAt          DateTime     @default(now()) @map("created_at")

  submission       Submission?      @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  challengeAccount ChallengeAccount @relation(fields: [challengeAccountId], references: [id], onDelete: Cascade)
  reviewer         User             @relation("ReviewerReviewDecisions", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([submissionId])
  @@index([challengeAccountId])
  @@index([reviewerId])
  @@index([status])
  @@index([createdAt])
  @@map("review_decisions")
}

model PayoutRequest {
  id                      String       @id @default(cuid())
  challengeAccountId      String       @map("challenge_account_id")
  userId                  String       @map("user_id")
  requestedAmount         Decimal      @map("requested_amount") @db.Decimal(12, 2)
  currency                String       @db.VarChar(10)
  status                  PayoutStatus @default(requested)
  eligibilitySnapshotJson Json         @map("eligibility_snapshot_json")
  rejectionReason         String?      @map("rejection_reason") @db.Text
  requestedAt             DateTime     @default(now()) @map("requested_at")
  reviewedAt              DateTime?    @map("reviewed_at")
  paidAt                  DateTime?    @map("paid_at")
  reviewerId              String?      @map("reviewer_id")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  challengeAccount ChallengeAccount @relation(fields: [challengeAccountId], references: [id], onDelete: Restrict)
  user             User             @relation("PayoutRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewer         User?            @relation("PayoutReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([challengeAccountId])
  @@index([userId])
  @@index([status])
  @@index([requestedAt])
  @@index([reviewerId])
  @@map("payout_requests")
}

model Payment {
  id                 String          @id @default(cuid())
  userId             String          @map("user_id")
  challengeAccountId String?         @map("challenge_account_id")
  provider           PaymentProvider
  providerReference  String?         @unique @map("provider_reference")
  checkoutUrl        String?         @map("checkout_url")
  amount             Decimal         @db.Decimal(12, 2)
  currency           String          @db.VarChar(10)
  status             PaymentStatus   @default(pending)
  paidAt             DateTime?       @map("paid_at")
  rawPayloadJson     Json?           @map("raw_payload_json")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  challengeAccount ChallengeAccount? @relation(fields: [challengeAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([challengeAccountId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model AuditLog {
  id            String          @id @default(cuid())
  actorUserId   String?         @map("actor_user_id")
  entityType    AuditEntityType @map("entity_type")
  entityId      String          @map("entity_id")
  eventType     AuditEventType  @map("event_type")
  oldValuesJson Json?           @map("old_values_json")
  newValuesJson Json?           @map("new_values_json")
  metadataJson  Json?           @map("metadata_json")
  ipAddress     String?         @map("ip_address")
  userAgent     String?         @map("user_agent") @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")

  actorUser User? @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminNote {
  id                 String   @id @default(cuid())
  challengeAccountId String   @map("challenge_account_id")
  adminUserId        String   @map("admin_user_id")
  note               String   @db.Text
  createdAt          DateTime @default(now()) @map("created_at")

  challengeAccount ChallengeAccount @relation(fields: [challengeAccountId], references: [id], onDelete: Cascade)
  adminUser        User             @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([challengeAccountId])
  @@index([adminUserId])
  @@index([createdAt])
  @@map("admin_notes")
}

model BrokerAccount {
  id String @id @default(cuid())

  challengeAccountId String           @map("challenge_account_id")
  challengeAccount   ChallengeAccount @relation(fields: [challengeAccountId], references: [id])

  brokerName          String @map("broker_name")
  accountType         String @map("account_type") // DEMO | REAL
  platformType        String @map("platform_type") // MT4 | MT5
  accountLogin        String @map("account_login")
  serverName          String @map("server_name")
  investorPasswordEnc String @map("investor_password_enc")

  verificationStatus String    @default("pending") @map("verification_status") // pending | verified | failed
  verificationNotes  String?   @map("verification_notes")
  verifiedAt         DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([challengeAccountId])
  @@map("broker_accounts")
}

model CtaClickEvent {
  id        String   @id @default(cuid())
  placement String
  label     String?
  href      String?
  pagePath  String?  @map("page_path")
  referrer  String?
  userAgent String?  @map("user_agent")
  country   String?
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([placement])
  @@index([createdAt])
  @@map("cta_click_events")
}
